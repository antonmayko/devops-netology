all:
  hosts:

%{~ for i in k8s ~}

    ${i["name"]}:
      ansible_host: ${i["network_interface"][0]["nat_ip_address"]}
      ansible_user: ubuntu
      ip: ${i["network_interface"][0]["ip_address"]}
      access_ip: ${i["network_interface"][0]["ip_address"]}

%{~ endfor ~}

  children:
    kube_control_plane:
      hosts:
        node1:
        node2:
    kube_node:
      hosts:
        node1:
        node2:
        node3:
        node4:
    etcd:
      hosts:
        node1:
        node2:
        node3:
    k8s_cluster:
      children:
        kube_control_plane:
        kube_node:
    calico_rr:
      hosts: {}